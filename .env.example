# Copie este arquivo para ".env" e preencha com suas credenciais reais.
# Nunca commite o arquivo ".env" (ele já está no .gitignore).

# --- Facebook Marketing API ---
# Token de acesso com permissões ads_management, ads_read e business_management.
# Recomendado: token de usuário do sistema (System User), de longa duração.
FB_ACCESS_TOKEN=
# ID da conta de anúncios, com ou sem o prefixo "act_" (ex: act_1234567890 ou 1234567890)
FB_AD_ACCOUNT_ID=
FB_APP_ID=
FB_APP_SECRET=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Power BI (Push Dataset via Azure AD, fluxo client credentials) ---
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
# Preenchido após rodar scripts/setup_powerbi_dataset.py pela primeira vez
POWERBI_DATASET_ID=

# --- Config ---
# Caminho do arquivo de configuração (limites de segurança, parâmetros)
CONFIG_PATH=config/settings.yaml
