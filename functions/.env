# Valores não sensíveis das Cloud Functions (o Firebase lê este arquivo no deploy). Não é
# segredo — é só um identificador de configuração, como o próprio App ID. Segredos de
# verdade (META_APP_ID, META_APP_SECRET, TOKEN_API_KEY) ficam no Secret Manager, nunca aqui.

# ID da Configuração do "Login do Facebook para Empresas" (Meta for Developers -> Login do
# Facebook para Empresas -> Configurações de login) — define as permissões pedidas
# (ads_management, ads_read, business_management, pages_show_list, pages_read_engagement)
# em vez do connect_facebook pedir "scope" solto, que esse produto novo da Meta não aceita.
META_LOGIN_CONFIG_ID=2200187893884869
