__pycache__/
*.pyc
.env
.venv/
venv/
*.egg-info/
.pytest_cache/
.DS_Store
config/settings.local.yaml
preview_creative*.jpg

# Firebase (login com Facebook) — .firebaserc tem o ID do seu projeto, específico de cada
# instalação; veja .firebaserc.example. firebase-debug.log é só log local do CLI.
.firebaserc
firebase-debug.log
.firebase/
# functions/.env guarda só valores não sensíveis (ex: META_LOGIN_CONFIG_ID) e é versionado
# de propósito — segredos de verdade ficam no Secret Manager, nunca em arquivo .env.
!functions/.env
