rules_version = '2';

// O token do Facebook só é lido/escrito pelas Cloud Functions (Admin SDK), que ignora estas
// regras — elas existem só pra bloquear qualquer acesso direto vindo do navegador/app
// cliente, caso alguém tente ler a coleção "tokens" diretamente pelo SDK do Firebase.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
